[alias]
	recent = "!f() { list() { { git for-each-ref --format=\"%(refname:short)\" refs/heads; echo; git reflog --format=%gs; } | awk -v n=\"$1\" \"!sep { if (\\$0 == \\\"\\\") sep = 1; else b[\\$0] = 1; next } sub(/^checkout: moving from .* to /, \\\"\\\") && (\\$0 in b) && !seen[\\$0]++ { print c+0 \\\": \\\" \\$0; if (++c == n) exit }\"; }; if [ -z \"$1\" ]; then list 5; return; fi; case \"$1\" in *[!0-9]*) ;; *) list \"$1\"; return ;; esac; n=; case \"$1\" in -) n=1 ;; -*[!0-9]*) [ -z \"$(printf %s \"$1\" | tr -d -)\" ] && n=${#1} ;; -?*) n=${1#-} ;; esac; if [ -z \"$n\" ]; then echo \"usage: git recent [count] | git recent -N | git recent --- (N dashes)\" >&2; return 1; fi; b=$(list $((n + 1)) | sed -n \"$((n + 1))s/^[0-9]*: //p\"); if [ -z \"$b\" ]; then echo \"git recent has no branch $n\" >&2; return 1; fi; git switch \"$b\"; }; f"
